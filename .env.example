# Server Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_os?schema=public

# Session Secret (Minimum 32 characters for security)
SESSION_SECRET=dev-student-os-session-secret-change-in-production-min32chars

# File Storage (local | s3 | r2)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Logging Level (debug | info | warn | error)
LOG_LEVEL=debug
